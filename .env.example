# PokeDrafts environment variables.
#
# Two env files are used, both git-ignored:
#   .env.local    read by Next.js (browser + server). The public keys, plus the
#                 optional stream keys (server only) and error reports switch
#                 below.
#   .env.scripts  read by the seeding scripts in scripts/ (npm run seed:*).
# Copy the matching block into each file and fill in the values from the
# Supabase dashboard: Project Settings > API.

# ---------------------------------------------------------------- .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional, server only (no NEXT_PUBLIC_ prefix, so never sent to the browser):
# whether a public league's stream is on air, for the Watch pages
# (docs/release-architecture.md section 15.4). Without them a public league
# counts as live only while its draft runs. Set the same names on the host.
# TWITCH_CLIENT_ID=your-twitch-app-client-id
# TWITCH_CLIENT_SECRET=your-twitch-app-client-secret
# YOUTUBE_API_KEY=your-youtube-data-api-key

# Optional: error reports (docs/release-architecture.md section 17). "on"
# makes the browser post its errors to /api/error-reports and logs them, with
# the server's errors, as "[pokedrafts] error report" lines. Read at build
# time, so set it on the host and deploy again; leave it unset locally.
# NEXT_PUBLIC_ERROR_REPORTING=on

# -------------------------------------------------------------- .env.scripts
# The service-role key bypasses row level security. Keep it out of .env.local
# and out of every deploy target; only the local seeding scripts need it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
