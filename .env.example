# PokeDrafts environment variables.
#
# Two env files are used, both git-ignored:
#   .env.local    read by Next.js (browser + server). Only the public keys.
#   .env.scripts  read by the seeding scripts in scripts/ (npm run seed:*).
# Copy the matching block into each file and fill in the values from the
# Supabase dashboard: Project Settings > API.

# ---------------------------------------------------------------- .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# -------------------------------------------------------------- .env.scripts
# The service-role key bypasses row level security. Keep it out of .env.local
# and out of every deploy target; only the local seeding scripts need it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
