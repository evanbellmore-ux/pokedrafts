		inherit: true,
		isNonstandard: null,
	},
## bestow games=ultra_sun_ultra_moon :: base data/moves.ts:1237-1263 | gen7 data/mods/gen7/moves.ts:35-38
--- base 1237
	bestow: {
		num: 516,
		accuracy: true,
		basePower: 0,
		category: "Status",
		isNonstandard: "Past",
		name: "Bestow",
		pp: 15,
		priority: 0,
		flags: { mirror: 1, bypasssub: 1, allyanim: 1, noassist: 1, failcopycat: 1 },
		onHit(target, source, move) {
			if (target.item) {
				return false;
			}
			const myItem = source.takeItem();
			if (!myItem) return false;
			if (!this.singleEvent('TakeItem', myItem, source.itemState, target, source, move, myItem) || !target.setItem(myItem)) {
				source.item = myItem.id;
				return false;
			}
			this.add('-item', target, myItem.name, '[from] move: Bestow', `[of] ${source}`);
		},
		target: "normal",
		type: "Normal",
		zMove: { boost: { spe: 2 } },
		contestType: "Cute",
	},
--- gen7 35
